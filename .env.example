# Every variable is optional: compose.yaml falls back to the defaults shown here.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

POSTGRES_USER=study
POSTGRES_PASSWORD=study
POSTGRES_DB=study
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=3000

CORS_ORIGINS=http://localhost:3000
# When set, GET /metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=
