# Every variable is optional: compose.yaml falls back to the defaults shown here.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

POSTGRES_USER=study
POSTGRES_PASSWORD=study
POSTGRES_DB=study
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=3000

CORS_ORIGINS=http://localhost:3000
# When set, GET /metrics requires "Authorization: Bearer <token>".
METRICS_TOKEN=
# Required in production: at least 32 random characters.
SECRET_KEY=
# Blank means Secure cookies only in production. Set to false only when production
# is served over plain HTTP, or the browser drops the cookies and sign-in bounces
# back to /login.
COOKIE_SECURE=

# auto (the default), mock or openai. auto uses openai once OPENAI_API_KEY is set
# and the offline mock models otherwise.
LLM_PROVIDER=
# A key switches from the offline mock models to a real model. A local server that
# checks no key, such as Ollama, still needs one set here: any placeholder works.
OPENAI_API_KEY=
# Blank means https://api.openai.com/v1. Any OpenAI-compatible API works, e.g.
# OpenRouter https://openrouter.ai/api/v1 or Ollama http://host.docker.internal:11434/v1
LLM_BASE_URL=
# Blank means gpt-5.4-mini.
LLM_MODEL=
# auto (the default), mock or openai. auto uses openai once embeddings have a key: with
# EMBEDDING_API_KEY and EMBEDDING_BASE_URL both blank, that is OPENAI_API_KEY, sent to
# LLM_BASE_URL. When LLM_BASE_URL is Ollama, set mock here, or set EMBEDDING_MODEL to a
# model it serves that returns 1536-dimensional vectors.
EMBEDDING_PROVIDER=
# A key for an embeddings endpoint of its own. With it or EMBEDDING_BASE_URL set,
# embeddings never use OPENAI_API_KEY.
EMBEDDING_API_KEY=
# Needs EMBEDDING_API_KEY (a local server takes any dummy key). Blank with a key set
# means https://api.openai.com/v1.
EMBEDDING_BASE_URL=
# Blank means text-embedding-3-small. The model must return 1536-dimensional vectors.
EMBEDDING_MODEL=
